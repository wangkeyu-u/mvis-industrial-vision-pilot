{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.mvis/schemas/ksdd-sft-record-1.0.0.json",
  "title": "MLX-VLM-compatible KSDD SFT record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "entity_id",
    "split",
    "dataset_version",
    "source_dataset_version",
    "prompt_version",
    "prompt_variant",
    "images",
    "messages"
  ],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "valid", "test"]},
    "dataset_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_dataset_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "prompt_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*-[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "prompt_variant": {"type": "string", "minLength": 1},
    "images": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "messages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "content"],
          "properties": {
            "role": {"const": "user"},
            "content": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "image"],
                  "properties": {
                    "type": {"const": "image"},
                    "image": {"type": "string", "minLength": 1}
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "text"],
                  "properties": {
                    "type": {"const": "text"},
                    "text": {"type": "string", "minLength": 1}
                  }
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "content"],
          "properties": {
            "role": {"const": "assistant"},
            "content": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "text"],
                "properties": {
                  "type": {"const": "text"},
                  "text": {"type": "string", "minLength": 2}
                }
              }
            }
          }
        }
      ]
    }
  }
}
